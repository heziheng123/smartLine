# 仅供 `wrangler pages dev` 本地调试 Pages Functions 使用。
# 复制为 .dev.vars 后填写真实值；.dev.vars 已被 .gitignore 忽略。
LIVEBLOCKS_SECRET_KEY=sk_test_your_secret_key_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
ALLOWED_GITHUB_LOGIN=your_github_login
SMARTLINE_SESSION_SECRET=replace_with_at_least_32_random_characters

# 可选：只允许 localhost 绕过 GitHub 登录，不得用于正式部署。
AUTH_ALLOW_DEV_BYPASS=false
DEV_AUTH_USER_ID=local-development-user
