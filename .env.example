# 兼容模式：未配置认证端点时仍使用当前公开密钥，不影响既有部署。
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_test_your_key_here

# 正式环境启用 GitHub 身份认证后设置。浏览器通过同源 Pages Function
# 获取仅允许当前账号工作区的 Liveblocks 访问令牌；确认迁移稳定前请保留上面的 Public Key。
# VITE_LIVEBLOCKS_AUTH_ENDPOINT=/api/liveblocks-auth

# 统一工作区完成迁移并稳定运行30天后才设置为true。
# VITE_DISABLE_PUBLIC_KEY_FALLBACK=false

# 构建时可关闭独立思维导图入口；关闭不会删除其独立 IndexedDB 数据。
VITE_MIND_MAP_ENABLED=true

# 真实双浏览器 Liveblocks Gate 通过后才设为 true；导图和图片均使用 Liveblocks 免费存储。
VITE_MIND_MAP_SYNC_ENABLED=false
